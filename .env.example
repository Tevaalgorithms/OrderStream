# OrderStream — Environment Variables
# Copy this file to .env and adjust values for your environment
# For local development with Docker Compose, the defaults here work as-is.

# ── AWS (LocalStack for local dev) ──
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566   # Points to LocalStack locally; remove for real AWS

# ── Kinesis ──
KINESIS_STREAM_NAME=ecommerce-events-stream

# ── SQS Queue URLs ──
SQS_ORDER_CREATED_QUEUE_URL=http://localhost:4566/000000000000/order-created-queue
SQS_INVENTORY_RESERVED_QUEUE_URL=http://localhost:4566/000000000000/inventory-reserved-queue
SQS_INVENTORY_FAILED_QUEUE_URL=http://localhost:4566/000000000000/inventory-failed-queue
SQS_PAYMENT_PROCESSED_QUEUE_URL=http://localhost:4566/000000000000/payment-processed-queue
SQS_PAYMENT_FAILED_QUEUE_URL=http://localhost:4566/000000000000/payment-failed-queue

# ── Databases ──
ORDER_DATABASE_URL=postgresql+asyncpg://orders_user:orders_pass@localhost:5433/orders_db
INVENTORY_DATABASE_URL=postgresql+asyncpg://inventory_user:inventory_pass@localhost:5434/inventory_db
PAYMENT_DATABASE_URL=postgresql+asyncpg://payments_user:payments_pass@localhost:5435/payments_db
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://notifications_user:notifications_pass@localhost:5436/notifications_db
ANALYTICS_DATABASE_URL=postgresql+asyncpg://analytics_user:analytics_pass@localhost:5437/analytics_db

# ── Payment Gateway ──
PAYMENT_GATEWAY_FAIL_RATE=0.2    # 20% failure rate for local testing; set to 0.0 for always-succeed

# ── Service URLs (internal — used for sync REST callbacks) ──
ORDER_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8002
